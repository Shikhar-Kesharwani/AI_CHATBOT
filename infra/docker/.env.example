# ── Application ──────────────────────────────────────
# Streamlit will serve on this port (overrides the default 7860)
APP_PORT=8501

# ── AI API Keys ──────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── MinIO (Self-Hosted S3 for document uploads) ──────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET=adaptive-rag-docs

# ── Security ─────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_string_min_32_chars

# ── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:8501

# ── Monitoring (optional) ─────────────────────────────
SENTRY_DSN=
